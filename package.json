{
  "name": "browser-execution-runtime",
  "version": "0.2.1",
  "description": "Open provider-agnostic browser execution runtime for AI agents. No API key required.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ber": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "INTEGRATING.md",
    "PUBLISHING.md",
    "ARCHITECTURE.md",
    "examples",
    "extension",
    "sdk/python",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs --setup-only",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "daemon": "tsx src/cli.ts daemon",
    "doctor": "tsx src/cli.ts doctor",
    "init-config": "tsx src/cli.ts init-config",
    "tools": "tsx src/cli.ts tools",
    "hermes-tools": "tsx src/cli.ts tools",
    "bench:replay": "tsx benchmarks/experience-replay.ts",
    "test": "vitest run && vitest run --config vitest.experience.config.ts",
    "test:experience": "vitest run --config vitest.experience.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "rust:test": "cargo test -p ber-core",
    "rust:build": "cargo build -p ber-core --release",
    "prepublishOnly": "npm test && npm run build && npm run pack:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shehrii9/browser-execution-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/shehrii9/browser-execution-runtime/issues"
  },
  "homepage": "https://github.com/shehrii9/browser-execution-runtime#readme",
  "keywords": [
    "browser",
    "cdp",
    "agent",
    "automation",
    "runtime",
    "openai-compatible",
    "playwright"
  ],
  "author": "Shahryar Ahmad <https://github.com/shehrii9>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
