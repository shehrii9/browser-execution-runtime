{
  "name": "browser-execution-runtime",
  "version": "0.1.0",
  "description": "Open provider-agnostic browser execution runtime for AI agents. No API key required.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ber": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "INTEGRATING.md",
    "PUBLISHING.md",
    "examples",
    "extension",
    "sdk/python"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "daemon": "tsx src/cli.ts daemon",
    "doctor": "tsx src/cli.ts doctor",
    "init-config": "tsx src/cli.ts init-config",
    "tools": "tsx src/cli.ts tools",
    "hermes-tools": "tsx src/cli.ts tools",
    "bench:replay": "tsx benchmarks/experience-replay.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "browser",
    "cdp",
    "agent",
    "automation",
    "runtime",
    "openai-compatible",
    "playwright"
  ],
  "author": "Shahryar Ahmad <https://github.com/shehrii9>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
