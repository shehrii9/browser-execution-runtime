{
  "manifest_version": 3,
  "name": "BER Debug Bridge",
  "version": "0.2.0",
  "description": "Attach-only debug bridge for browser-execution-runtime. No AI inside.",
  "action": {
    "default_title": "BER Debug Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "commands": {
    "observe-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Observe current tab via BER daemon"
    }
  }
}
