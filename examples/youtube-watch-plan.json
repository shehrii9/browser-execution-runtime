{
  "goal": "Open a YouTube watch page, skip ad if present, play video",
  "steps": [
    {
      "id": "go",
      "action": {
        "type": "navigate",
        "url": "https://www.youtube.com/watch?v=jNQXAC9IVRw"
      }
    },
    {
      "id": "settle",
      "action": { "type": "wait", "settle": true, "timeoutMs": 10000 }
    },
    {
      "id": "overlays",
      "action": { "type": "dismiss_overlays" },
      "optional": true
    },
    {
      "id": "player",
      "action": {
        "type": "wait",
        "target": { "css": "ytd-player, #movie_player, video" },
        "timeoutMs": 15000
      }
    },
    {
      "id": "skip",
      "action": { "type": "media", "command": "skip_ad" },
      "optional": true
    },
    {
      "id": "play",
      "action": { "type": "media", "command": "play" }
    }
  ]
}
